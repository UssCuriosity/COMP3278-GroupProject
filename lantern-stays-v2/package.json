{
  "name": "lantern-stays",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "COMP3278 final project: a short-stay booking web app (TypeScript, Fastify, React, MySQL)",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch server/src/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts && tsc -p server/tsconfig.build.json",
    "prestart": "npm run build",
    "start": "node dist/server/main.js",
    "db:setup": "tsx scripts/setup-db.ts",
    "test": "vitest run --config server/vitest.config.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/session": "^11.1.6",
    "@fastify/static": "^10.1.10",
    "@tanstack/react-query": "^5.107.1",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "mysql2": "^3.24.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
