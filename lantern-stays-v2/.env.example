# Copy this file to ".env" and fill in your MySQL password.

# Web server
PORT=3000

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lantern_stays

# Signs the login session cookie: any random text of 32 characters or more
SESSION_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

# Show the SQL statements behind every action in the in-app "SQL inspector"
SQL_INSPECTOR=true
