# Copy this file to ".env" and fill in your MySQL password.

# Web server
PORT=3000

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lantern_stays

# Signs the login session cookie (any random string works for local use)
SESSION_SECRET=change-me-to-any-random-string

# Show recorded SQL statements in the in-app "SQL inspector"
SQL_INSPECTOR=true
